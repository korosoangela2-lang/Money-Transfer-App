# Copy to .env if you want to override any of these defaults.

# Enables Flask's debugger and auto-reload. Local development only — never
# set this to 1 in production, the interactive debugger allows arbitrary
# code execution to anyone who can reach the server.
FLASK_DEBUG=1

# Path to the JSON file used as the datastore. Defaults to Backend/db.json,
# created automatically (and seeded with demo data) on first request.
DB_FILE=./db.json

SECRET_KEY=change-me-to-a-random-string

# Origin the Vite dev server runs on, for CORS.
CORS_ORIGIN=http://localhost:5173

PORT=5000
