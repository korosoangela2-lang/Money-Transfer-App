{
  "info": {
    "name": "Halcyon Banking API",
    "description": "Full API coverage for the Halcyon Banking Flask backend: auth, wallet, beneficiaries, transactions/transfers, money requests, rates, and admin.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "halcyon-banking-api-collection"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "userEmail", "value": "" },
    { "key": "userPassword", "value": "TestPass123" },
    { "key": "token", "value": "" },
    { "key": "recipientEmail", "value": "" },
    { "key": "recipientPassword", "value": "TestPass123" },
    { "key": "recipientToken", "value": "" },
    { "key": "adminEmail", "value": "postman.admin@halcyon.com" },
    { "key": "adminPassword", "value": "PostmanPass123" },
    { "key": "adminToken", "value": "" },
    { "key": "beneficiaryId", "value": "" },
    { "key": "requestId", "value": "" },
    { "key": "adminUserId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/health" },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (primary user)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Tester\",\n  \"email\": \"postman.user.{{$timestamp}}@example.com\",\n  \"phone\": \"0712345678\",\n  \"country\": \"Kenya\",\n  \"password\": \"{{userPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('userEmail', `postman.user.${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.expect(body.token).to.be.a('string');",
                  "pm.collectionVariables.set('token', body.token);",
                  "pm.collectionVariables.set('userEmail', body.user.email);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register (recipient user)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Recipient\",\n  \"email\": \"postman.recipient.{{$timestamp}}@example.com\",\n  \"phone\": \"0798765432\",\n  \"country\": \"Kenya\",\n  \"password\": \"{{recipientPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('recipientEmail', `postman.recipient.${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('recipientToken', body.token);",
                  "pm.collectionVariables.set('recipientEmail', body.user.email);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (primary user)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('token', body.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (bad password)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"wrong-password\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.user.role).to.eql('admin');",
                  "pm.collectionVariables.set('adminToken', body.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Restore session",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/session",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"] }
            }
          ]
        },
        {
          "name": "Update profile",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/auth/me",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Tester Updated\",\n  \"phone\": \"0711223344\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('name updated', () => pm.expect(pm.response.json().name).to.eql('Postman Tester Updated'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Forgot password",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/forgot-password",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{userEmail}}\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"] }
            }
          ]
        },
        {
          "name": "Reset password (invalid token)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/reset-password",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"not-a-real-token\",\n  \"password\": \"NewPass1234\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('status 400', () => pm.response.to.have.status(400));"] }
            }
          ]
        }
      ]
    },
    {
      "name": "Rates",
      "item": [
        {
          "name": "Get rates",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/rates" },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"] }
            }
          ]
        }
      ]
    },
    {
      "name": "Wallet",
      "item": [
        {
          "name": "Add funds",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/wallet/add-funds",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 500,\n  \"source\": \"Card\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('type topup', () => pm.expect(pm.response.json().type).to.eql('topup'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Withdraw",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/wallet/withdraw",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 50,\n  \"destination\": \"Card\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('status 201', () => pm.response.to.have.status(201));"] }
            }
          ]
        },
        {
          "name": "Withdraw (insufficient balance)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/wallet/withdraw",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 999999,\n  \"destination\": \"Card\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('status 400', () => pm.response.to.have.status(400));"] }
            }
          ]
        }
      ]
    },
    {
      "name": "Beneficiaries",
      "item": [
        {
          "name": "List beneficiaries",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/beneficiaries",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"] }
            }
          ]
        },
        {
          "name": "Add beneficiary",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/beneficiaries",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"relation\": \"Sister\",\n  \"currency\": \"KES\",\n  \"country\": \"Kenya\",\n  \"flag\": \"🇰🇪\",\n  \"method\": \"mobile\",\n  \"account\": \"0700111222\",\n  \"bank\": \"\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('beneficiaryId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Remove beneficiary",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/beneficiaries/{{beneficiaryId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"] }
            }
          ]
        }
      ]
    },
    {
      "name": "Transactions & Transfers",
      "item": [
        {
          "name": "Re-add beneficiary for send",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/beneficiaries",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Smith\",\n  \"relation\": \"Friend\",\n  \"currency\": \"KES\",\n  \"country\": \"Kenya\",\n  \"flag\": \"🇰🇪\",\n  \"method\": \"mobile\",\n  \"account\": \"0700333444\",\n  \"bank\": \"\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('beneficiaryId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Send money (transfer to beneficiary)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/transfers",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"beneficiaryId\": \"{{beneficiaryId}}\",\n  \"amount\": 20,\n  \"method\": \"mobile\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('type send', () => pm.expect(pm.response.json().type).to.eql('send'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Send to user (P2P)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/transfers/to-user",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{recipientEmail}}\",\n  \"amount\": 10\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('type p2p_out', () => pm.expect(pm.response.json().type).to.eql('p2p_out'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List transactions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/transactions",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('is array', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Money Requests",
      "item": [
        {
          "name": "Create request",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/requests",
            "header": [
              { "key": "Authorization", "value": "Bearer {{recipientToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"amount\": 15,\n  \"note\": \"Postman test request\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('requestId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List requests (payer)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/requests",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"] }
            }
          ]
        },
        {
          "name": "Pay request",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/requests/{{requestId}}/pay",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('status paid', () => pm.expect(pm.response.json().status).to.eql('paid'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Decline request (already settled)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/requests/{{requestId}}/decline",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('status 400 (already settled)', () => pm.response.to.have.status(400));"] }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Admin dashboard data",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/data",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.expect(body.users).to.be.an('array');",
                  "pm.expect(body.transactions).to.be.an('array');",
                  "pm.expect(body.revenue).to.be.an('array');"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin dashboard data (non-admin forbidden)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/data",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('status 403', () => pm.response.to.have.status(403));"] }
            }
          ]
        },
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/admin/users",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Admin Created User\",\n  \"email\": \"admin.created.{{$timestamp}}@example.com\",\n  \"phone\": \"0700000000\",\n  \"country\": \"Kenya\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('adminUserId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update user",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/admin/users/{{adminUserId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"suspended\",\n  \"balance\": 250\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"] }
            }
          ]
        },
        {
          "name": "Delete user",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/admin/users/{{adminUserId}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }]
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"] }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth cleanup",
      "item": [
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/logout",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"] }
            }
          ]
        }
      ]
    }
  ]
}
